SPRING_DATASOURCE_URL=jdbc:postgresql://your-neon-host/your-database?user=your-neon-username&password=your-neon-password&sslmode=require

# Server Config
SERVER_PORT=8080

# Redis Configuration
SPRING_DATA_REDIS_URL=redis://localhost:6379

# Google OAuth
GOOGLE_OAUTH_CLIENT_ID=your-google-client-id
GOOGLE_OAUTH_CLIENT_SECRET=your-google-client-secret
