SPRING_DATASOURCE_URL=jdbc:postgresql://your-neon-host/your-database?user=your-neon-username&password=your-neon-password&sslmode=require

# Server Config
SERVER_PORT=8080

# Redis Configuration
SPRING_DATA_REDIS_URL=redis://localhost:6379

# Google OAuth
GOOGLE_OAUTH_CLIENT_ID=your-google-client-id
GOOGLE_OAUTH_CLIENT_SECRET=your-google-client-secret

# Gmail OAuth Refresh Token Encryption Key
# Must be a cryptographically secure 32-byte Base64-encoded string.
# In production, inject this securely using a secret manager.
GMAIL_TOKEN_ENCRYPTION_KEY=your-32-byte-base64-encoded-key-here

# Gmail Pub/Sub Integration
# Pub/Sub topic for Gmail push notifications. Format: projects/{PROJECT_ID}/topics/{TOPIC_NAME}
GMAIL_PUBSUB_TOPIC=projects/your-gcp-project-id/topics/gmail-notifications

# Public HTTPS endpoint URL that Google Pub/Sub will push to.
# This value is also used as the expected audience in Google-signed push JWTs.
# Must be a publicly reachable HTTPS URL — NOT localhost.
GMAIL_PUBSUB_PUSH_ENDPOINT=https://your-deployed-backend.example.com/api/internal/gmail/pubsub/push

# Service account email configured as the push subscription authentication identity.
# Injected via Secret Manager in production.
GMAIL_PUBSUB_SERVICE_ACCOUNT_EMAIL=your-sa@your-gcp-project-id.iam.gserviceaccount.com

# Telegram Bot API Configuration
TELEGRAM_BOT_TOKEN=your-telegram-bot-token
TELEGRAM_BOT_USERNAME=your_bot_username
TELEGRAM_API_BASE_URL=https://api.telegram.org
TELEGRAM_WEBHOOK_SECRET=your-webhook-secret-token

