# PlacementOS Backend Local Environment Configuration
#
# Instructions:
# 1. Copy this file and rename it to `.env` in the same directory (backend/).
# 2. Replace the placeholders below with your actual Neon PostgreSQL credentials.
# 3. DO NOT commit your `.env` file to version control.

SPRING_DATASOURCE_URL=jdbc:postgresql://your-neon-host/your-database?sslmode=require
SPRING_DATASOURCE_USERNAME=your-neon-username
SPRING_DATASOURCE_PASSWORD=your-neon-password

# Server Config
SERVER_PORT=8080
