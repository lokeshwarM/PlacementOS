# PlacementOS Local Environment Configuration
# 
# Instructions:
# 1. Copy this file and rename it to `.env` in the same directory.
# 2. Replace the placeholders below with your actual Neon PostgreSQL credentials.
# 3. DO NOT commit your `.env` file to version control.

DATABASE_URL=jdbc:postgresql://your_neon_host.neon.tech:5432/your_database_name?sslmode=require
DATABASE_USERNAME=your_neon_username
DATABASE_PASSWORD=your_neon_password

# Server Config
SERVER_PORT=8080
