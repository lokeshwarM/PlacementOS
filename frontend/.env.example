# PlacementOS — Frontend Environment Configuration
#
# Copy this file to .env.local for local development.
# In production (Vercel / any host), set these as environment variables in the build settings.
#
# IMPORTANT: NEXT_PUBLIC_* variables are embedded into the client bundle at build time.
# Do NOT place secrets in NEXT_PUBLIC_* variables.
# Do NOT leave NEXT_PUBLIC_API_URL pointing to localhost in production builds.

# ─────────────────────────────────────────────────────────────────────────────
# Backend API base URL — REQUIRED in production
# Development:  http://localhost:8080/api/v1
# Staging:      https://staging.api.example.com/api/v1
# Production:   https://api.example.com/api/v1
# ─────────────────────────────────────────────────────────────────────────────
NEXT_PUBLIC_API_URL=http://localhost:8080/api/v1
