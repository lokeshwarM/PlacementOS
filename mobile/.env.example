# PlacementOS — Mobile Environment Configuration
#
# Copy this file to .env or .env.local for local development.
#
# NOTE: Android emulator accesses host machine's localhost via 10.0.2.2.
# Physical devices require the host's LAN IP (e.g., http://192.168.1.x:8080/api/v1).
# Production builds use your deployed backend URL.
#
# EXPO_PUBLIC_* variables are embedded into client JS bundle. Do NOT store secrets here.
#
# Development (Android Emulator): http://10.0.2.2:8080/api/v1
# Development (Physical Device):   http://<YOUR_LAN_IP>:8080/api/v1
# Production:                     https://api.example.com/api/v1
EXPO_PUBLIC_API_URL=http://10.0.2.2:8080/api/v1
